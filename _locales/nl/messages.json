			"completed": {
				"content": "$1",
				"example": "3"
			},
			"total": {
				"content": "$2",
				"example": "5"
			}
		}
	},
	"buildingZip": {
		"message": "ZIP maken…"
	},
	"savedActivities": {
		"message": "$COUNT$ activiteiten opgeslagen.",
		"placeholders": {
			"count": {
				"content": "$1",
				"example": "5"
			}
		}
	},
	"savedWithSkips": {
		"message": "$OK$ opgeslagen, $FAILED$ overgeslagen ($REASON$)",
		"placeholders": {
			"ok": {
				"content": "$1",
				"example": "3"
			},
			"failed": {
				"content": "$2",
				"example": "2"
			},
			"reason": {
				"content": "$3",
				"example": "HTTP 404"
			}
		}
	},
	"downloadFailed": {
		"message": "Mislukt: $REASON$",
		"placeholders": {
			"reason": {
				"content": "$1",
				"example": "Netwerkfout"
			}
		}
	},
	"rowDownloadFailed": {
		"message": "$ID$ kon niet worden gedownload: $MESSAGE$",
		"placeholders": {
			"id": {
				"content": "$1",
				"example": "12345"
			},
			"message": {
				"content": "$2",
				"example": "Netwerkfout"
			}
		}
	},
